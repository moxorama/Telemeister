{
  "name": "telemeister",
  "version": "0.2.5",
  "description": "TypeScript Telegram Bot Boilerplate with XState",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/moxorama/Telemeister.git"
  },
  "bin": {
    "telemeister": "./bin/telemeister.js"
  },
  "exports": {
    ".": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./core/bot": {
      "import": "./dist/core/bot/index.js",
      "types": "./dist/core/bot/index.d.ts"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "src/templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && cp -r src/templates dist/templates && pnpm run build:cli",
    "build:cli": "esbuild dist/cli/cli.js --bundle --platform=node --format=esm --outfile=bin/telemeister-cli.js --external:typescript --external:tsx --external:prisma",
    "example:recreate": "rm -rf examples/demo-bot && tsx src/cli/cli.ts create-bot demo-bot && mv demo-bot examples/demo-bot && npm pkg set --prefix examples/demo-bot dependencies.telemeister='workspace:*' && rm -rf examples/demo-bot/node_modules examples/demo-bot/pnpm-lock.yaml examples/demo-bot/dev.db examples/demo-bot/.env",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "./scripts/release.sh"
  },
  "workspaces": [
    "examples/*"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "telegram",
    "bot",
    "boilerplate",
    "xstate",
    "typescript",
    "prisma",
    "state-machine"
  ],
  "author": "George Khromchenko",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.4.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.4.7",
    "ejs": "^4.0.1",
    "express": "^4.21.2",
    "grammy": "^1.35.1",
    "mariadb": "^3.4.0",
    "xstate": "^5.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.6",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prisma": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.39.0"
  }
}
